# OpenAI API Key
# Erhalte deinen Schlüssel unter: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Server Port
PORT=3000

# Erlaubte Origins (komma-getrennt)
# Für Produktion: https://ki.berufsumstieg.de
# Für Entwicklung: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://ki.berufsumstieg.de

# Node Umgebung
NODE_ENV=development
